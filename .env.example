# systemd: user service (default). manual: foreground server for containers/WSL
# without a user systemd manager; run custom-opencode-serve after installation.
CUSTOM_OPENCODE_SERVICE_MODE=systemd

# Copy to .env and replace every placeholder before installation.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CHANGE_ME
# Web login session. "Remember me" stores only a signed HttpOnly cookie, never
# the password itself. auto detects normal HTTPS reverse proxies.
OPENCODE_AUTH_SESSION_SECONDS=86400
OPENCODE_AUTH_REMEMBER_SECONDS=2592000
OPENCODE_AUTH_COOKIE_SECURE=auto
# Legacy Basic Auth is disabled by default. Enable only for old external clients
# that still send Authorization: Basic.
OPENCODE_AUTH_ALLOW_BASIC=0

OPENCODE_WEB_HOST=localhost
OPENCODE_WEB_PORT=4098
# Optional path to the multi-user accounts store (JSON).
# Default: $XDG_CONFIG_HOME/opencode/users.json (or ~/.config/opencode/users.json).
# OPENCODE_USERS_FILE=
# Keep disabled for normal installs. When explicitly enabled, bypass is accepted
# only for direct localhost requests and never for reverse-proxy forwarded traffic.
OPENCODE_WEB_ALLOW_LOCAL=0
OPENCODE_SCRATCH_DIRECTORY=
# Optional shared plan directory for OpenCode, web, and TUI. Empty uses ~/.opencode/plan.
OPENCODE_PLAN_DIRECTORY=
# WSLg may advertise a Wayland socket without a usable seat. When X11 is
# available, the TUI launcher selects the working X11 clipboard backend.
# Set to 1 only when the WSL Wayland clipboard is known to work.
OPENCODE_TUI_PREFER_WAYLAND=0
# Semicolon-separated roots exposed by the authenticated web folder browser.
OPENCODE_PROJECT_ROOTS=~
# Optional persistent state for legacy project/workflow metadata.
CUSTOM_OPENCODE_FEATURE_STATE=
# Runtime uses SQLite/WAL for tasks, checkpoints, events, artifacts, usage and memory.
# Default: sibling runtime-v2.sqlite3 under ~/.local/state/custom-opencode.
CUSTOM_OPENCODE_RUNTIME_DB=

# Deterministic server-side permission policy: safe | workspace | autonomous.
OPENCODE_PERMISSION_POLICY=workspace
OPENCODE_PERMISSION_AUDIT=1

# The OpenCode V2 guard plugin talks only to the local custom web control plane.
# Empty token falls back to OPENCODE_SERVER_PASSWORD. Set an independent random
# token if the OpenCode service and web client should use separate credentials.
OPENCODE_RUNTIME_PLUGIN_TOKEN=
OPENCODE_RUNTIME_PLUGIN_HOST=127.0.0.1
OPENCODE_RUNTIME_PLUGIN_TIMEOUT_MS=1800

# Provider-locked Alibaba Cloud orchestration roles.
OPENCODE_PLANNER_MODEL=bailian-cli/qwen3.8-max
OPENCODE_BUILDER_MODEL=bailian-cli/qwen3.7-plus
OPENCODE_READER_MODEL=bailian-cli/qwen3.8-flash
OPENCODE_REVIEW_MODEL=bailian-cli/deepseek-v4-pro-0813
OPENCODE_LONG_HORIZON_MODEL=bailian-cli/glm-5.2
# Dedicated friendly model ID used only to attach the orchestrator policy to Max.
OPENCODE_ORCHESTRATED_MODEL=bailian-cli/qwen3.8-orchestrated
# Dedicated OpenAI SOL alias. Its orchestration workers use Terra for building,
# Luna for bounded reading and review.
OPENCODE_SOL_ORCHESTRATED_MODEL=openai/gpt-5.6-sol-orchestrated
OPENCODE_SOL_BUILDER_MODEL=openai/gpt-5.6-terra
OPENCODE_SOL_READER_MODEL=openai/gpt-5.6-luna
OPENCODE_SOL_REVIEW_MODEL=openai/gpt-5.6-luna
# Canonical effort is selected by profile/agent variants: reader=low,
# builder=medium -> high -> max, planner=high/max, reviewer=high/max.
# "max" means highest supported provider effort, not necessarily literal max.

# Repository semantic index. "auto" uses sentence-transformers when installed
# and falls back to a deterministic hashed embedding index otherwise.
OPENCODE_REPO_EMBEDDINGS=auto
OPENCODE_REPO_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Tool gateway / artifact / loop policy.
OPENCODE_MCP_RATE_LIMIT=120
OPENCODE_TOOL_ARTIFACT_THRESHOLD=24000
OPENCODE_LOOP_LIMIT=3

# Universal MCP facade (five tools; empty until private layers are configured).
# Install scripts/tool-fabric-requirements.txt in a dedicated venv first.
OPENCODE_TOOL_FABRIC=0
# Absolute venv interpreter and launcher paths, also used by the native service.
# OPENCODE_FABRIC_PYTHON=/path/to/venv/bin/python
# OPENCODE_FABRIC_LAUNCHER=/path/to/custom_opencode/scripts/tool-fabric.sh
# Trusted operator policy outside project workspaces; see docs/tool-fabric.md.
# OPENCODE_FABRIC_CONFIG=/path/to/operator/tool-fabric.json

# Verification/review/watchdog policy.
# Verification executes repository-defined test/lint scripts. Keep untrusted
# repositories fail-closed unless you explicitly opt them into local execution.
OPENCODE_VERIFY_PIPELINE=auto
OPENCODE_VERIFY_TRUST_REPO=0
OPENCODE_VERIFY_TIMEOUT=120
OPENCODE_VERIFY_AUTOFIX=1
OPENCODE_RUNTIME_RETENTION_DAYS=30
OPENCODE_AUTO_REVIEW=smart
OPENCODE_STUCK_PROGRESS_POLLS=100
OPENCODE_STUCK_ACTION=warn

# Secret broker. Values are not serialized to the browser/runtime snapshots.
# OPENCODE_SECRET_SCOPES syntax: scope=NAME,NAME;other-scope=NAME
OPENCODE_SECRET_PREFIXES='TOKEN_PLAN_;OPENAI_;GITHUB_;MCP_;QDRANT_;HF_;GEMINI_;GOOGLE_'
OPENCODE_SECRET_SCOPES=
# Only explicitly named secrets can be injected into agent-created shell processes.
OPENCODE_SHELL_SECRET_REFS=

# Enforced sandbox profiles. safe/repo-write require bubblewrap unless the
# explicit unsandboxed escape hatch is enabled; full-machine has its own switch.
OPENCODE_ALLOW_FULL_MACHINE=0
OPENCODE_ALLOW_UNSANDBOXED=0
OPENCODE_SANDBOX_DOCKER_IMAGE=python:3.12-slim
OPENCODE_DOCKER_NETWORK=0
OPENCODE_DOCKER_READONLY=0

# Optional remote task notification sink. Remote hosts are disabled by default;
# localhost can be used without enabling OPENCODE_NOTIFICATION_ALLOW_REMOTE.
OPENCODE_NOTIFICATION_WEBHOOK=
OPENCODE_NOTIFICATION_ALLOW_REMOTE=0

OPENCODE_LOCAL_URL=http://localhost:4098
OPENCODE_LAN_URL=https://your-lan-hostname
OPENCODE_TAILSCALE_URL=https://your-tailnet-hostname

# Optional explicit backend. Normally service discovery is used instead.
OPENCODE_BACKEND_URL=
OPENCODE_BACKEND_USERNAME=opencode
OPENCODE_BACKEND_PASSWORD=
OPENCODE_SERVICE_FILE=
OPENCODE_LEGACY_AUTH_FILE=

# Optional CLI integrations for the sidebar provider rate-limit snapshots.
CODEX_BIN=
BAILIAN_CLI_BIN=
OPENCODE_LIMITS_CACHE_SECONDS=60
# TUI child-process watchdog for codex/bl limit probes.
OPENCODE_TUI_LIMITS_COMMAND_TIMEOUT_MS=10000
# Keep mouse interactions/clickable TUI controls enabled, but make Ctrl+C the
# explicit copy path instead of copy-on-mouse-up. This avoids stale OpenTUI
# selection state in terminals such as VS Code while preserving mouse input.
OPENCODE_EXPERIMENTAL_DISABLE_COPY_ON_SELECT=1

# Local RAG lifecycle: auto = detect a usable checkout, 0 = intentionally off,
# 1 = required (installation fails if configured/detected RAG is unusable).
MCP_RAG_ENABLED=auto
MCP_RAG_ROOT=
MCP_RAG_BIN=

# Local DipTrace MCP lifecycle: auto detects a sibling ../mcp_diptrace checkout,
# 0 keeps the server intentionally disabled, and 1 requires a valid setup.
# This integration is always read-only; its policy is not user-configurable.
DIPTRACE_MCP_ENABLED=auto
DIPTRACE_MCP_ROOT=
DIPTRACE_MCP_BIN=
# Empty safely defaults to DIPTRACE_MCP_ROOT, never to the whole home directory.
DIPTRACE_MCP_WORKSPACE=
# Empty safely defaults to DIPTRACE_MCP_WORKSPACE.
DIPTRACE_MCP_ALLOWED_ROOTS=
# Empty leaves state placement to the DipTrace MCP platform default.
DIPTRACE_MCP_STATE_DIR=

# Ponytail plugin (upstream DietrichGebert/ponytail, pinned commit).
# 1 = enabled (default), 0 = disabled. Managed checkout is provisioned at
# $XDG_DATA_HOME/opencode/ponytail (or ~/.local/share/opencode/ponytail).
PONYTAIL_ENABLED=1
# Default mode for ponytail: off, lite, full, or ultra. Only written on first
# install; never overwrites user's choice in ~/.config/opencode/.ponytail-active.
PONYTAIL_DEFAULT_MODE=full
# The managed checkout uses the reviewed upstream and commit below by default.
# Override these only when intentionally reviewing a separately approved pin.
# PONYTAIL_UPSTREAM_URL=https://github.com/DietrichGebert/ponytail.git
# PONYTAIL_PIN_COMMIT=2ed6c52c9d7e5e56942508591085fd45dea277d3
# PONYTAIL_CHECKOUT_DIR=

# Model provider endpoints. Ollama remains an ordinary manual provider only; the
# role router never selects it or inspects its availability.
OLLAMA_BASE_URL=http://localhost:11434/v1
TOKEN_PLAN_API_KEY=CHANGE_ME
TOKEN_PLAN_ANTHROPIC_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1
TOKEN_PLAN_OPENAI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
TOKEN_PLAN_PROBE_MODEL=qwen3.8-max
QWEN_QUOTA_PROBE_ENABLED=0
BAILIAN_CONFIG_PATH=

# Installer settings. Keep OPENCODE_CONFIG_DIR empty for the V2 shared service.
OPENCODE_CLI_PACKAGE=@opencode-ai/cli@0.0.0-beta-18743
OPENCODE_CONFIG_DIR=
OPENCODE_AUTH_FILE=
OPENCODE_CONFIG_BACKUP_DIR=
OPENCODE_CONFIG_BACKUP_KEEP=20
INSTALL_OPENCODE_CONFIG=1
CUSTOM_OPENCODE_INSTALL_SELFTEST=1

# Optional OpenCode account backup. Keep these values only in your private .env.
OPENCODE_OPENAI_ACCESS=CHANGE_ME
OPENCODE_OPENAI_REFRESH=CHANGE_ME
OPENCODE_OPENAI_EXPIRES=0
OPENCODE_OPENAI_ACCOUNT_ID=CHANGE_ME
OPENCODE_ZEN_KEY=CHANGE_ME
OPENCODE_GO_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
