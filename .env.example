# Copy to .env and replace every placeholder before installation.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=CHANGE_ME

OPENCODE_WEB_HOST=localhost
OPENCODE_WEB_PORT=4098
OPENCODE_WEB_ALLOW_LOCAL=1
OPENCODE_SCRATCH_DIRECTORY=
# Semicolon-separated roots exposed by the authenticated web folder browser.
OPENCODE_PROJECT_ROOTS=~

# Server-side permission policy: safe | workspace | autonomous.
# workspace auto-allows read-only work, workspace-local edits and bounded tests;
# destructive, sensitive, external and ambiguous actions still ask.
OPENCODE_PERMISSION_POLICY=workspace
OPENCODE_PERMISSION_AUDIT=1
CUSTOM_OPENCODE_STATE_DIR=

OPENCODE_LOCAL_URL=http://localhost:4098
OPENCODE_LAN_URL=https://your-lan-hostname
OPENCODE_TAILSCALE_URL=https://your-tailnet-hostname

# Optional explicit backend. Normally service discovery is used instead.
OPENCODE_BACKEND_URL=
OPENCODE_BACKEND_USERNAME=opencode
OPENCODE_BACKEND_PASSWORD=
OPENCODE_SERVICE_FILE=
OPENCODE_LEGACY_AUTH_FILE=

# Optional CLI integrations for the sidebar provider rate-limit snapshots.
# Leave paths empty to resolve executables from PATH and common user install paths.
CODEX_BIN=
BAILIAN_CLI_BIN=
OPENCODE_LIMITS_CACHE_SECONDS=60

# Local RAG lifecycle: auto = detect a usable checkout, 0 = intentionally off,
# 1 = required (installation fails if the configured/detected RAG is unusable).
MCP_RAG_ENABLED=auto
MCP_RAG_ROOT=
MCP_RAG_BIN=

# Local and remote model providers.
OLLAMA_BASE_URL=http://localhost:11434/v1
TOKEN_PLAN_API_KEY=CHANGE_ME
TOKEN_PLAN_ANTHROPIC_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1
TOKEN_PLAN_OPENAI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
TOKEN_PLAN_PROBE_MODEL=qwen3.8-max
# Opt-in only: this sends a one-token completion periodically. The web quota
# panel can use Bailian CLI usage without enabling this model request.
QWEN_QUOTA_PROBE_ENABLED=0
BAILIAN_CONFIG_PATH=

# Local Ollama is manual-only by default. Set AUTO_START=1 only if you want the
# optional lazy local-router hook to start your own router when you select Ollama.
OPENCODE_LOCAL_AUTO_START=0
OPENCODE_LOCAL_PROVIDER=ollama
OPENCODE_LOCAL_ROUTER_URL=
OPENCODE_LOCAL_ROUTER_START=
OPENCODE_LOCAL_ROUTER_LOG=

# Installer settings. Keep OPENCODE_CONFIG_DIR empty for the V2 shared service;
# its supported global configuration root is ~/.config/opencode.
OPENCODE_CONFIG_DIR=
OPENCODE_AUTH_FILE=
OPENCODE_CONFIG_BACKUP_DIR=
OPENCODE_CONFIG_BACKUP_KEEP=20
INSTALL_OPENCODE_CONFIG=1
# Default 1: run static verification before writes and real zero-LLM-token
# service/backend/RAG checks after restart. Set 0 only for emergency recovery.
CUSTOM_OPENCODE_INSTALL_SELFTEST=1

# Optional OpenCode account backup. Keep these values only in your private .env.
OPENCODE_OPENAI_ACCESS=CHANGE_ME
OPENCODE_OPENAI_REFRESH=CHANGE_ME
OPENCODE_OPENAI_EXPIRES=0
OPENCODE_OPENAI_ACCOUNT_ID=CHANGE_ME
OPENCODE_ZEN_KEY=CHANGE_ME
OPENCODE_GO_KEY=CHANGE_ME