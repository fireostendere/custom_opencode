{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "accent-ember"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "grouping": "auto"
  },
  "keybinds": {
    "prompt.history.previous": "up",
    "prompt.history.next": "down",
    "app.exit": "ctrl+shift+q"
  },
  "animations": true,
  "mouse": true
}
