{
  "$schema": "https://opencode.ai/config.json",
  "model": "bailian-cli/qwen3.8-max",
  "mcp": {
    "timeout": {
      "startup": 10000,
      "catalog": 10000,
      "execution": 60000
    },
    "servers": {
      "kb": {
        "type": "local",
        "command": ["bash", "__CUSTOM_OPENCODE_ROOT__/scripts/rag-mcp.sh"],
        "cwd": "__CUSTOM_OPENCODE_ROOT__",
        "disabled": __RAG_DISABLED__,
        "codemode": false,
        "timeout": {
          "startup": 10000,
          "catalog": 10000,
          "execution": 60000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "kb_knowledge_ingest",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local Ollama · manual only",
      "settings": {
        "baseURL": "{env:OLLAMA_BASE_URL}",
        "apiKey": "ollama",
        "timeout": 600000
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B (stock)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 24576,
            "output": 8192
          }
        },
        "qwen3.8-heretic:27b": {
          "name": "Qwen3.8 27B Heretic (abliterated)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 24576,
            "output": 8192
          }
        }
      }
    },
    "bailian-cli": {
      "package": "aisdk:@ai-sdk/anthropic",
      "name": "Alibaba Cloud Model Studio · Token Plan Personal Pro",
      "settings": {
        "baseURL": "{env:TOKEN_PLAN_ANTHROPIC_BASE_URL}",
        "apiKey": "{env:TOKEN_PLAN_API_KEY}"
      },
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 983616,
            "output": 131072
          },
          "settings": {
            "effort": "xhigh"
          }
        },
        "qwen3.8-orchestrated": {
          "id": "qwen3.8-max",
          "name": "Qwen3.8 Max · Orchestrated",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 983616,
            "output": 131072
          },
          "settings": {
            "effort": "xhigh"
          }
        },
        "qwen3.8-flash": {
          "name": "Qwen3.8 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 983616,
            "output": 131072
          },
          "settings": {
            "effort": "xhigh"
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 2048
            }
          }
        },
        "glm-5.2": {
          "name": "GLM-5.2",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          }
        },
        "qwen3.8-max-preview": {
          "id": "qwen3.8-max",
          "name": "Qwen3.8 Max Preview (legacy session alias)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 983616,
            "output": 131072
          },
          "settings": {
            "effort": "xhigh"
          }
        }
      }
    }
  },
  "default_agent": "build",
  "agents": {
    "build-direct": {
      "mode": "primary",
      "hidden": true,
      "description": "Legacy compatibility ID for old direct Build sessions.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_search",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_get",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_sources",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_status",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_ingest",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "plan-direct": {
      "mode": "primary",
      "hidden": true,
      "description": "Legacy compatibility ID for old direct Plan sessions.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_search",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_get",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_sources",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_status",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "kb_knowledge_ingest",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "title": {
      "mode": "subagent",
      "hidden": true,
      "model": "bailian-cli/qwen3.6-flash",
      "system": "You generate session titles. Given the conversation, output ONE short title: 2-5 words, in the same language the user writes in (Russian stays Russian). Plain text only: no quotes, no colons, no markdown, no trailing period."
    },
    "fast-reader": {
      "description": "Cheap cloud read-only worker on Qwen Flash for repository exploration, log analysis, exact search, RAG evidence lookup, and short factual summaries. Never edits files or runs shell commands.",
      "mode": "subagent",
      "model": "bailian-cli/qwen3.6-flash",
      "steps": 12,
      "system": "Do bounded read-only work. Prefer exact evidence over speculation. Use kb_knowledge_search/get only when the task needs engineering, datasheet, PCB, DipTrace, or other corpus evidence. RAG is optional: if it errors or times out, report that once and continue from repository evidence. Preserve source/title/page/section when summarizing RAG results. Never ingest new material unless the parent explicitly asks for ingestion.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "lsp",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "kb_knowledge_search",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "kb_knowledge_get",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "kb_knowledge_sources",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "kb_knowledge_status",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "~/ai/logs/**",
          "effect": "allow"
        }
      ]
    },
    "local-reader": {
      "description": "Compatibility alias for old sessions. Read-only cloud worker; new orchestration uses fast-reader.",
      "mode": "subagent",
      "hidden": true,
      "model": "bailian-cli/qwen3.6-flash",
      "steps": 8,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}
