  "default_agent": "build",
  "agents": {
    "build": {
      "mode": "primary",
      "system": "{file:__CONFIG_DIR__/prompts/orchestrator.md}",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "local-reader",
          "effect": "ask"
        }
      ]
    },
    "plan": {
      "mode": "primary",
      "system": "{file:__CONFIG_DIR__/prompts/orchestrator.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "local-reader",
          "effect": "ask"
        }
      ]
    },
    "title": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/hy3-free",
      "system": "You generate session titles. Given the conversation, output ONE short title: 2-5 words, in the same language the user writes in (Russian stays Russian). Plain text only: no quotes, no colons, no markdown, no trailing period."
    },
    "local-reader": {
      "description": "Read-only local worker for repository exploration, log analysis, file and symbol search, error extraction, and short factual summaries. Use it only for bounded mechanical reading tasks.",
      "mode": "subagent",
      "model": "opencode/hy3-free",
      "steps": 12,
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "lsp",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "~/ai/logs/**",
          "effect": "allow"
        }
      ]
    }
  }
}
