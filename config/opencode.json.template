{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local Ollama (RX 9070 XT hybrid)",
      "settings": {
        "baseURL": "{env:OLLAMA_BASE_URL}",
        "apiKey": "ollama",
        "timeout": 600000
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B (stock)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
